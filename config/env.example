# ==============================================================================
# stockiq - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit the actual .env file or real secrets to source control.

# Application Environment
NODE_ENV=development
APP_NAME=stockiq
APP_PORT=3000
APP_HOST=0.0.0.0
APP_URL=http://localhost:3000

# Security & Session Configuration
JWT_SECRET=development-only-jwt-secret-min-32-chars-long-do-not-use-in-prod
JWT_EXPIRY_SECONDS=900
SESSION_SECRET=development-only-session-secret-min-32-chars
COOKIE_SECURE=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stockiq_dev
DB_USER=stockiq_user
DB_PASSWORD=development_only_password
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# Adapter Modes (Options: "mock" | "live")
# Note: Initial foundation uses mock adapters. Live adapters will be enabled in future phases.
OTP_ADAPTER_MODE=mock
PAYMENT_ADAPTER_MODE=mock
MARKET_DATA_ADAPTER_MODE=mock
ESIGN_ADAPTER_MODE=mock
PARRVA_ADAPTER_MODE=mock

# External Adapter Credentials (Populate when switching from mock to live)
# OTP Service (e.g. SMS / Email Gateway)
OTP_GATEWAY_API_KEY=
OTP_EXPIRY_SECONDS=300

# Payment Gateway (e.g. Razorpay / Cashfree)
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Market Data Feed (Licensed Tick Provider)
MARKET_DATA_API_KEY=
MARKET_DATA_WS_URL=

# Electronic Signature (eSign ESP Provider)
ESIGN_PROVIDER_CLIENT_ID=
ESIGN_PROVIDER_CLIENT_SECRET=

# PaRRVA (Performance and Return Reporting & Verification Architecture)
PARRVA_API_ENDPOINT=
PARRVA_PARTNER_CODE=
PARRVA_API_KEY=
